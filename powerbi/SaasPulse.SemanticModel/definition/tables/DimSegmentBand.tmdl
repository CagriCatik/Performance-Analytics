table DimSegmentBand

	column band
		dataType: string
		isKey
		sortByColumn: sort_order
		summarizeBy: none
		sourceColumn: band

	column sort_order
		dataType: int64
		summarizeBy: none
		sourceColumn: sort_order

	partition DimSegmentBand = m
		mode: import
		source =
			let Source = #table(type table [band = text, sort_order = Int64.Type], {{"SMB", 1}, {"Mid-Market", 2}, {"Enterprise", 3}}) in Source
