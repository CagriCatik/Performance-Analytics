// Generated by scripts/build_powerbi_project.py. Do not edit manually.

Accounts =
DISTINCTCOUNT(DimAccount[account_id])

Active Subscriptions =
CALCULATE(DISTINCTCOUNT(DimSubscription[subscription_id]), DimSubscription[status] = "Active")

Total Subscriptions =
DISTINCTCOUNT(DimSubscription[subscription_id])

Churned Subscriptions =
CALCULATE(DISTINCTCOUNT(DimSubscription[subscription_id]), DimSubscription[status] = "Churned")

Trial Subscriptions =
CALCULATE(DISTINCTCOUNT(DimSubscription[subscription_id]), DimSubscription[status] = "Trial")

Suspended Subscriptions =
CALCULATE(DISTINCTCOUNT(DimSubscription[subscription_id]), DimSubscription[status] = "Suspended")

Total ARR EUR =
SUMX(FILTER(DimSubscription, DimSubscription[status] = "Active"), DimSubscription[annual_value_eur])

Total MRR EUR =
SUMX(FILTER(DimSubscription, DimSubscription[status] = "Active"), DimSubscription[mrr_eur])

Average MRR per Subscription EUR =
DIVIDE([Total MRR EUR], [Active Subscriptions])

Monthly Revenue EUR =
SUM(FactMonthlyMetrics[mrr_eur])

Revenue at Risk EUR =
SUM(FactMonthlyMetrics[revenue_at_risk_eur])

Revenue at Risk % =
DIVIDE([Revenue at Risk EUR], [Monthly Revenue EUR])

Churn Rate % =
DIVIDE([Churned Subscriptions], [Total Subscriptions])

Logo Churn Rate % =
VAR TotalAccounts = DISTINCTCOUNT(DimAccount[account_id])
VAR ChurnedAccounts = CALCULATE(DISTINCTCOUNT(DimSubscription[account_id]), DimSubscription[status] = "Churned")
RETURN DIVIDE(ChurnedAccounts, TotalAccounts)

Total Subscription Events =
COUNTROWS(FactSubscriptionEvents)

Churn Events =
CALCULATE(COUNTROWS(FactSubscriptionEvents), FactSubscriptionEvents[event_type] = "Churn")

Upgrade Events =
CALCULATE(COUNTROWS(FactSubscriptionEvents), FactSubscriptionEvents[event_type] = "Upgrade")

Downgrade Events =
CALCULATE(COUNTROWS(FactSubscriptionEvents), FactSubscriptionEvents[event_type] = "Downgrade")

Renewal Events =
CALCULATE(COUNTROWS(FactSubscriptionEvents), FactSubscriptionEvents[event_type] = "Renewal")

Net MRR Movement EUR =
SUM(FactSubscriptionEvents[mrr_change_eur])

Expansion MRR EUR =
CALCULATE(SUM(FactSubscriptionEvents[mrr_change_eur]), FactSubscriptionEvents[event_type] = "Upgrade")

Contraction MRR EUR =
CALCULATE(SUM(FactSubscriptionEvents[mrr_change_eur]), FactSubscriptionEvents[event_type] IN {"Downgrade", "Churn"})

Average Active User Ratio =
AVERAGE(FactMonthlyMetrics[active_user_ratio])

Total Active Users =
SUM(FactMonthlyMetrics[active_users])

Total Licensed Users =
SUM(FactMonthlyMetrics[licensed_users])

Average NPS Score =
AVERAGE(FactMonthlyMetrics[nps_score])

Average Feature Adoption % =
AVERAGE(FactMonthlyMetrics[feature_adoption_pct])

Total API Calls =
SUM(FactMonthlyMetrics[api_calls])

Average Storage GB =
AVERAGE(FactMonthlyMetrics[storage_gb])

Support Tickets =
DISTINCTCOUNT(FactSupportTickets[ticket_id])

Open Tickets =
CALCULATE([Support Tickets], FactSupportTickets[status] = "Open")

Closed Tickets =
CALCULATE([Support Tickets], FactSupportTickets[status] = "Closed")

Critical Tickets =
CALCULATE([Support Tickets], FactSupportTickets[severity] = "Critical")

Open Critical Tickets =
CALCULATE([Support Tickets], FactSupportTickets[status] = "Open", FactSupportTickets[severity] = "Critical")

Ticket Closure Rate % =
DIVIDE([Closed Tickets], [Support Tickets])

First Contact Resolution % =
DIVIDE(CALCULATE([Support Tickets], FactSupportTickets[first_contact_resolution] = TRUE()), CALCULATE([Support Tickets], FactSupportTickets[status] = "Closed"))

Escalation Rate % =
DIVIDE(CALCULATE([Support Tickets], FactSupportTickets[escalated] = TRUE()), [Support Tickets])

Average Resolution Hours =
AVERAGE(FactSupportTickets[resolution_hours])

Tickets per Subscription =
DIVIDE([Support Tickets], [Active Subscriptions])

Refund Requests =
DISTINCTCOUNT(FactRefunds[refund_id])

Approved Refunds =
CALCULATE([Refund Requests], FactRefunds[approved] = TRUE())

Refund Approval % =
DIVIDE([Approved Refunds], [Refund Requests])

Refund Amount EUR =
CALCULATE(SUM(FactRefunds[amount_eur]), FactRefunds[approved] = TRUE())

Average Refund EUR =
DIVIDE([Refund Amount EUR], [Approved Refunds])

Refund Rate % =
DIVIDE([Refund Requests], [Support Tickets])

Subscription Health Score =
VAR ChurnRisk = [Churn Rate %]
VAR LowAdoption = CALCULATE([Average Feature Adoption %]) < 0.40
VAR HighRisk = CALCULATE([Revenue at Risk %]) > 0.20
VAR TicketsHigh = CALCULATE([Tickets per Subscription]) > 3
RETURN MAX(0, 100 - IF(ChurnRisk > 0.1, 30, 0) - IF(LowAdoption, 20, 0) - IF(HighRisk, 25, 0) - IF(TicketsHigh, 15, 0))

Health Score Color =
VAR Score = [Subscription Health Score]
RETURN SWITCH(TRUE(), Score >= 80, "#1AAB40", Score >= 60, "#118DFF", Score >= 40, "#E66C37", "#D64550")

Live Active Sessions =
CALCULATE(COUNTROWS(FactLiveActivity), FactLiveActivity[status] = "Active Session")

Live Idle Sessions =
CALCULATE(COUNTROWS(FactLiveActivity), FactLiveActivity[status] = "Idle")

Live Connected Subscriptions =
COUNTROWS(FactLiveActivity)

Live Total Active Users =
SUM(FactLiveActivity[active_users])

Live Avg Session Duration Min =
AVERAGE(FactLiveActivity[session_duration_min])

Live API Requests/Hour =
SUM(FactLiveActivity[api_requests_last_hour])

MRR Previous Month EUR =
CALCULATE([Monthly Revenue EUR], DATEADD(DimDate[date], -1, MONTH))

MRR MoM Growth % =
DIVIDE([Monthly Revenue EUR] - [MRR Previous Month EUR], [MRR Previous Month EUR])

Tickets Previous Month =
CALCULATE([Support Tickets], DATEADD(DimDate[date], -1, MONTH))

Tickets MoM % =
DIVIDE([Support Tickets] - [Tickets Previous Month], [Tickets Previous Month])

Data Snapshot Date =
FORMAT(MAX(FactMonthlyMetrics[month_date]), "yyyy-MM-dd")

MRR Growth Target % =
0.05

FCR Target % =
0.75

Feature Adoption Target % =
0.60

NPS Target =
40
