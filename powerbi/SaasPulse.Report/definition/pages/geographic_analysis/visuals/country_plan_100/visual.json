{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "country_plan_100",
  "position": {
    "x": 40,
    "y": 690,
    "z": 3,
    "width": 950,
    "height": 360,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "hundredPercentStackedColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimAccount"
                    }
                  },
                  "Property": "country"
                }
              },
              "queryRef": "DimAccount.country",
              "nativeQueryRef": "country",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimSubscription"
                    }
                  },
                  "Property": "plan_name"
                }
              },
              "queryRef": "DimSubscription.plan_name",
              "nativeQueryRef": "plan_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "KPI_Measures"
                    }
                  },
                  "Property": "Active Subscriptions"
                }
              },
              "queryRef": "KPI_Measures.Active Subscriptions",
              "nativeQueryRef": "Active Subscriptions",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Plan Mix by Country'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
