{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "live_feature_bar",
  "position": {
    "x": 600,
    "y": 185,
    "z": 2,
    "width": 620,
    "height": 360,
    "tabOrder": 2
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactLiveActivity"
                    }
                  },
                  "Property": "current_feature"
                }
              },
              "queryRef": "FactLiveActivity.current_feature",
              "nativeQueryRef": "current_feature",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "KPI_Measures"
                    }
                  },
                  "Property": "Live Connected Subscriptions"
                }
              },
              "queryRef": "KPI_Measures.Live Connected Subscriptions",
              "nativeQueryRef": "Live Connected Subscriptions",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Most Used Features Right Now'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
