{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "churn_decomp",
  "position": {
    "x": 40,
    "y": 600,
    "z": 6,
    "width": 1180,
    "height": 440,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimAccount"
                    }
                  },
                  "Property": "segment"
                }
              },
              "queryRef": "DimAccount.segment",
              "nativeQueryRef": "segment",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimSubscription"
                    }
                  },
                  "Property": "plan_name"
                }
              },
              "queryRef": "DimSubscription.plan_name",
              "nativeQueryRef": "plan_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "KPI_Measures"
                    }
                  },
                  "Property": "Churn Events"
                }
              },
              "queryRef": "KPI_Measures.Churn Events",
              "nativeQueryRef": "Churn Events",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Churn Events by Segment & Plan'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
