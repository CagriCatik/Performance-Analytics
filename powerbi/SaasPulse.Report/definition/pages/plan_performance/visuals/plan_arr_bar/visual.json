{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "plan_arr_bar",
  "position": {
    "x": 40,
    "y": 185,
    "z": 1,
    "width": 550,
    "height": 370,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimSubscription"
                    }
                  },
                  "Property": "plan_name"
                }
              },
              "queryRef": "DimSubscription.plan_name",
              "nativeQueryRef": "plan_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "KPI_Measures"
                    }
                  },
                  "Property": "Total ARR EUR"
                }
              },
              "queryRef": "KPI_Measures.Total ARR EUR",
              "nativeQueryRef": "Total ARR EUR",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'ARR Contribution by Plan'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
